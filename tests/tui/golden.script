# golden.script: every view, popup, the live update and the integrity checks, 200x50.
# Run by tests/tui_golden.sh (fixture: fixture.sh, session files under ./root).
# no key pressed: the newest session is selected and its turns show, newest first
Snap:00-start
Exec:printf 'placeholder new turn while untouched' | "$XKSM_CLI" turn --harness omp --session o-one --role user --cwd /tmp/placeholder-project --time-us 1793894620000000
Sync
Snap:00-live-untouched
# a new session starts: the selection on the newest session follows it
Exec:printf 'placeholder first turn of a new session' | "$XKSM_CLI" turn --harness claude-code --session sess-new --role user --cwd /tmp/placeholder-project --time-us 1793894720000000
Sync
Snap:00-new-session-followed
Home
Snap:01-sessions
End
Enter
# turns newest first: assistant, tool_result, tool_use, thinking, user
Snap:02-turns
Down
Down
Enter
# the tool_use turn: memory, source and session file SHA-256, each recomputed
Snap:03-detail
Esc
Home
# another process stores a turn in the open session: it arrives on top, marked +, selected
Exec:printf 'placeholder live turn delta' | "$XKSM_CLI" turn --harness claude-code --session sess-a --role user --cwd /tmp/placeholder-project --time-us 1793887340000000
Sync
Snap:04-live-turn
# a sync without a change keeps the screen as it is
Sync
Snap:05-live-unchanged
# the session file of the tool_use turn is changed on disk: the detail shows it
Exec:for f in root/claude-code/*_sess-a/*_tool_use_*.md; do printf x >> "$f"; done
Down
Down
Down
Enter
Snap:06-detail-file-differs
Esc
5
V
Snap:07-verify-mismatch
Exec:"$XKSM_CLI" mirror > /dev/null
V
Snap:08-verify-repaired
2
/
